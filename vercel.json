{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,Australia Flights*.json,North America Flights*.json,Aer Lingus Rewards*.json}",
      "excludeFiles": "{history/**,test/**,.env,.env.*}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
